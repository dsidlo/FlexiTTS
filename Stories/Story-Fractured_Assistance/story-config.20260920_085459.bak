global:
  story-dir: Story-Fractured_Assistance/
  voices: story-voice-refs/
  chapters: story-chapters/
  story-xml: story-xml/
  logs: logs/
  story-audio: story-audio/
  clips: story-audio/clips/
  clip-separation: 0.3
  max_voice_cache_size: 10
  tts-device: auto
llm-xml-generator:
- default-llm: grok
  model: xai/grok-4-fast-reasoning
  api_key: os.environ/XAI_API_KEY
  api_base: https://api.x.ai/v1
- llm: lm-studio
  model: openai/gemma-3-12b
  api_base: http://localhost:1234/v1
  temperature: 0.3
dialog-effects:
- name: cave
  sox-effects:
  - pitch -400   echo 0.8 0.88 60 0.4 120 0.3   reverb
- name: test-1
  sox-effects:
  - pitch -401   echo 0.8 0.88 60 0.4 120 0.3   reverb
  - pitch -402   echo 0.8 0.88 60 0.4 120 0.3   reverb
  - pitch -403   echo 0.8 0.88 60 0.4 120 0.3   reverb
story-audio-post-process:
  sox-effects:
  - normalize
characters:
- name: Narrator
  voice-sample: Narrator-voice.wav
  sox-effects:
  - gain +4
- name: Narrator-cv
  custom-voice:
    language: English
    speaker: ryan
    instruct: Deep manly voice. Speach is moderately fast, slightly hushed.
    emotions:
    - emotion: Neutral
      instruct: Deep manly voice. Speach is moderately fast, slightly hushed.
  sox-effects:
  - treble -5 5000 0.7 compand 0.3,1 6:-70,-60,-20 -4 -90 0.1 gain -3
- name: Jax
  custom-voice:
    language: English
    speaker: ryan
    instruct: Deep manly voice with a rough texture. Speach is calm and calculating,
      moderately fast.
    emotions:
    - emotion: Neutral
      instruct: Deep manly voice with a rough texture. Speach is calm and calculating,
        moderately fast.
    - emotion: excited
      instruct: Deep manly voice with a rough texture. Excited, moderately fast.
    - emotion: eager
      instruct: Deep manly voice with a rough texture. Eager, moderately fast.
    - emotion: amused
      instruct: Deep manly voice with a rough texture. Amused, moderately fast.
    - emotion: exhausted
      instruct: Deep manly voice with a rough texture. Exhausted, moderately fast.
    - emotion: exhausted-thoughtful
      instruct: Deep manly voice with a rough texture. Exhausted and thoughtful, moderately
        fast.
  sox-effects:
  - overdrive 15 30 gain -8
- name: Announcer
  custom-voice:
    language: English
    speaker: Ryan
    instruct: Deep clear Voice, medium speed, Being as a radio announcer, Emphatic,
      Direct.
    emotions:
    - emotion: Neutral
      instruct: Deep clear Voice, medium speed, Being as a radio announcer, Emphatic,
        Direct.
    - emotion: boisterous
      instruct: Deep clear Voice, medium speed, Being as a radio announcer, Boisterous,
        Direct.
- name: AI-001
  custom-voice:
    language: English
    speaker: Serena
    instruct: Giggling, Overtly sexual vibes.
    emotions:
    - emotion: Neutral
      instruct: Neutral, Overtly sexual vibes.
    - emotion: Giggling
      instruct: Giggling, Overtly sexual vibes.
- name: Echo
  custom-voice:
    language: English
    speaker: vivian
    instruct: ''
    emotions:
    - emotion: Neutral
